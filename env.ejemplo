# Valores que cambian segun quien despliega el proyecto. Copiar y ajustar:
#   cp env.ejemplo .env      (.env esta en .gitignore: no se sube al repo)
# Los scripts de 02 a 05 leen este archivo; ninguno trae estos valores escritos.

# Bucket del data lake. Debe ser unico en todo S3 (por ejemplo, nombre en minusculas).
BUCKET_NAME=proyecto2-datalake-esteban

# Repositorio (usuario/repo) y rama de GitHub de donde la EC2 descarga los scripts al arrancar.
REPO_GITHUB=SofiAlfonso/proyecto2-bigdata
RAMA=scripts

# Region. El Learner Lab solo permite us-east-1 y us-west-2.
AWS_REGION=us-east-1

# Lo llena crear_emr.sh; lo usan ejecutar_hive.sh y el comando para terminar el cluster.
EMR_CLUSTER_ID=
